# Database
DATABASE_URL="postgresql://user:password@localhost:5432/paddleocr_dev"

# Application
APP_BASE_URL="http://localhost:3000"
NODE_ENV="development"

# Session
SESSION_EXPIRY_HOURS="12"

# Object Storage (S3-compatible)
OBJECT_STORAGE_ENDPOINT="http://localhost:9000"
OBJECT_STORAGE_ACCESS_KEY="minioadmin"
OBJECT_STORAGE_SECRET_KEY="minioadmin"
OBJECT_STORAGE_BUCKET="paddleocr-files"
OBJECT_STORAGE_REGION="us-east-1"

# PaddleOCR VL API
PADDLEOCR_VL_API_URL="https://api.paddleocr.com/v1"
PADDLEOCR_VL_API_KEY="your_api_key_here"
OCR_POLL_INTERVAL_MS="2000"
OCR_TIMEOUT_MS="300000"
OCR_ASSET_DOWNLOAD_TIMEOUT_MS="15000"

# Payment Provider
PAYMENT_PROVIDER="mock"
PAYMENT_API_KEY="your_payment_api_key"
PAYMENT_WEBHOOK_SECRET="your_webhook_secret"

# Worker
WORKER_CONCURRENCY="3"
WORKER_POLL_INTERVAL_MS="1000"

# DOCX Generation
DOCX_TEMPLATE_VERSION="1.0.0"
ALLOW_SYNC_OCR="true"

# Download
DOWNLOAD_URL_TTL_SEC="3600"

# Pricing (JSON string)
PRICING_CONFIG='{"exam":"2.00","handout":"1.50","homework":"1.00"}'

# Currency
DEFAULT_CURRENCY="CNY"
RECOMMENDED_TOPUP_AMOUNTS='["10.00","30.00","50.00","100.00"]'
